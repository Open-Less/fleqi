{
  "name": "fleqi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:engines": "bash scripts/prepare-engines.sh",
    "test:core": "cargo test --manifest-path crates/fleqi-core/Cargo.toml",
    "test:runtime": "pnpm --dir runtime/pi test",
    "test:engines": "cargo test --manifest-path crates/fleqi-core/Cargo.toml --test engines -- --ignored",
    "test": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check:commits": "node scripts/check-commits.mjs commit --range",
    "check:version": "node scripts/check-version.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.11.1",
    "border-beam": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "packageManager": "pnpm@10.30.1"
}
