{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleqi",
  "version": "0.0.1",
  "identifier": "app.fleqi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fleqi",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#FAFAFA",
        "visible": false
      },
      {
        "label": "settings",
        "title": "Fleqi \u8bbe\u7f6e",
        "url": "index.html?surface=settings#general",
        "width": 880,
        "height": 690,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "runtime-resources/bin/": "runtime/bin/",
      "runtime-resources/licenses/": "runtime/licenses/",
      "runtime-resources/pi.tar.gz": "runtime/pi.tar.gz",
      "runtime-resources/runtime-manifest.json": "runtime/runtime-manifest.json",
      "icons/Fleqi.icon/": "Fleqi.icon/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 500,
          "y": 180
        },
        "windowSize": {
          "width": 680,
          "height": 420
        }
      }
    }
  }
}
